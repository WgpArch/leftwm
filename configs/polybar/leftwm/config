[colors]
background = #0a0a0a
foreground = #ED9381
border = #C36C0F
secondary = #FFB86C
alert = #E06C75
success = #98C379
warning = #E5C07B

[bar/leftwm]
monitor = ${env:MONITOR:LVDS-1}
width = 99%
height = 38
offset-x = 1%
offset-y = 1%
radius-top = 10
radius-bottom = 10
fixed-center = true

background = ${colors.background}
foreground = ${colors.foreground}

border-top-size = 2
border-bottom-size = 2
border-left-size = 2
border-right-size = 2
border-color = ${colors.border}

padding-left = 0
padding-right = 0

module-margin-left = 3
module-margin-right = 3

font-0 = "Z003 Bold Italic:pixelsize=11;2"
font-1 = "JetBrainsMono Nerd Font:size=10;2"
font-2 = "Font Awesome 7 Brands:size=10;2"
font-3 = "Font Awesome 7 Free Solid:size=10;2"
font-4 = "Symbols Nerd Font:size=10;2"

modules-left = launcher xworkspaces tray nm-applet
modules-center =  date weather
modules-right = memory cpu temperature battery pulseaudio filesystem powermenu

tray-position = left
tray-padding = 5
tray-background = ${colors.background}

wm-restack = generic
override-redirect = true

cursor-click = pointer
cursor-scroll = ns-resize

[module/launcher]
type = custom/text
content = " 󰣇 "
content-foreground = ${colors.secondary}
content-background = ${colors.background}
click-left = rofi -show drun -font 'Z003' -theme ~/.config/leftwm/rofi/fancy2.rasi
click-right = rofi -show drun -font 'Z003' -theme ~/.config/leftwm/rofi/fancy2.rasi


[module/xworkspaces]
type = internal/xworkspaces
pin-workspaces = true
enable-click = true
enable-scroll = true
format = <label-state>
format-background = ${colors.background}

label-active = %name%
label-active-foreground = ${colors.secondary}
label-active-padding = 1
label-occupied = %name%
label-occupied-foreground = ${colors.foreground}
label-occupied-padding = 2
label-empty = %name%
label-empty-foreground = #555555
label-empty-padding = 2

[module/date]
type = custom/script
exec = date '+%Y %B %W %A %D  %H:%M:%S %p'
interval = 1
format-prefix = " "
format-prefix-foreground = ${colors.foreground-alt}
format-prefix-background = ${colors.background-alt}
format-prefix-padding = 1
label-background = ${colors.background-alt}
label-padding = 1
click-left = /home/wgparch/.config/polybar1/click_calendar.sh

[module/weather]
type = custom/script
exec = ~/.config/polybar1/weather.py
interval = 600
format = <label>
format-background = ${colors.background}
label = "%output%"
label-foreground = ${colors.foreground}
click-left = ~/.config/polybar1/click_weather.sh

[module/memory]
type = internal/memory
interval = 3
format = <label>
format-prefix = " "
format-prefix-foreground = ${colors.success}
format-background = ${colors.background}
label = "%percentage_used%%"
label-foreground = ${colors.foreground}

[module/cpu]
type = internal/cpu
interval = 3
format = <label>
format-prefix = " "
format-prefix-foreground = ${colors.warning}
format-background = ${colors.background}
label = "%percentage%%"
label-foreground = ${colors.foreground}

[module/temperature]
type = internal/temperature
thermal-zone = 0
warn-temperature = 60
format = <ramp> <label>
format-background = ${colors.background}
format-padding = 2
format-warn = <ramp> <label-warn>
format-warn-foreground = ${colors.alert}
label = %temperature-c%
label-warn = %temperature-c%
ramp-0 = 
ramp-1 = 
ramp-2 = 
ramp-foreground = ${colors.foreground}

[module/filesystem]
type = internal/fs
mount-0 = /
interval = 60
format-mounted = <label-mounted>
format-mounted-prefix = " "
format-mounted-prefix-foreground = ${colors.secondary}
format-mounted-background = ${colors.background}
label-mounted = "%percentage_used%%"
label-mounted-foreground = ${colors.foreground}

[module/pulseaudio]
type = internal/pulseaudio
format-volume = <ramp-volume>   <label-volume>
label-volume = %percentage%%
label-volume-foreground = ${colors.foreground}
format-volume-background = ${colors.background-alt}
format-volume-padding = 1
label-muted =  muted
label-muted-foreground = ${colors.alert}
format-muted-background = ${colors.background-alt}
format-muted-padding = 1
ramp-volume-0 = 
ramp-volume-1 = 
ramp-volume-2 = 
ramp-volume-3 = 
ramp-volume-4 = 
ramp-volume-5 = 
click-right = pavucontrol

[module/battery]
type = internal/battery
battery = BAT0
adapter = AC
full-at = 98

format-charging = <animation-charging> <label-charging>
format-charging-underline = #ffb52a
format-discharging = <animation-discharging> <label-discharging>
format-discharging-underline = ${self.format-charging-underline}
format-full-prefix = " "
format-full-prefix-foreground = ${colors.foreground-alt}
format-full-underline = ${self.format-charging-underline}
ramp-capacity-0 = 
ramp-capacity-1 = 
ramp-capacity-2 = 
ramp-capacity-foreground = ${colors.foreground-alt}
animation-charging-0 = 
animation-charging-1 = 
animation-charging-2 = 
animation-charging-foreground = ${colors.foreground-alt}
animation-charging-framerate = 750
animation-discharging-0 = 
animation-discharging-1 = 
animation-discharging-2 = 
animation-discharging-foreground = ${colors.foreground-alt}
animation-discharging-framerate = 750

[module/powermenu]
type = custom/text
content = " "
content-foreground = ${colors.alert}
content-background = ${colors.background}
click-left = ~/.config/leftwm/rofi/powermenu.sh

[settings]
screenchange-reload = true
pseudo-transparency = false
