/* Global settings and color variables */
* {
    bg-color: #0a0a0a;
    border-color: #C36C0F;
    text-color: #ED9381;
    highlight-bg: #C36C0F;
    highlight-text: #0a0a0a;
    spacing: 0.5em;
    padding: 0px;
}

window {
    border: 2px;
    border-color: #C36C0F;
    border-radius: 12px;
    background-color: transparent;
    background-image: url("/home/wgparch/Pictures/ALNW/Taxigirl_resized.jpg");
    color: #ED9381;
    height: 700px; 
    width: 680px;
}

mainbox {
    background-color: transparent; 
    border-radius: 10px;
    margin: 10px;
    padding: 10px;
    spacing: 10px;
}

inputbar {
    background-color: transparent;
    border: 0px;
    border-radius: 8px;
    padding: 10px;
    margin: 0px 0px 10px 0px;
    color: #ED9381;
    spacing: 10px;
}

prompt {
    background-color: transparent;
    text-color: #C36C0F;
    padding: 0px 10px 0px 0px;
}

entry {
    background-color: transparent;
    text-color: #ED9381;
    padding: 0px;
}

listview {
    border: 0px;
    border-radius: 8px;
    padding: 10px;
    margin: 0px;
    background-color: transparent;
    spacing: 0.4em;
    fixed-height: true;
    lines: 11;
}

element {
    padding: 8px 12px;
    margin: 2px 0px;
    border-radius: 6px;
    background-color: transparent;
    text-color: #ED9381;
    spacing: 0.5em;
}

element normal.normal {
    background-color: transparent;
    text-color: #ED9381;
}

element selected.normal {
    border: 1px;
    border-color: #C36C0F;
    border-radius: 6px;
    background-color: #C36C0F;
    text-color: #0a0a0a;
}

element normal.urgent {
    background-color: transparent;
    text-color: #E06C75;
}

element normal.active {
    background-color: transparent;
    text-color: #FFB86C;
}

message {
    margin: 10px;
    padding: 15px;
    border-radius: 8px;
    border: 1px;
    border-color: #C36C0F;
    background-color: #0a0a0a;
    text-color: #ED9381;
}

element-text, element-icon {
    background-color: inherit;
    text-color: inherit;
}
